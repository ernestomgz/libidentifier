# Python bytecode, environments and build output.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.release-venv/
venv/
.development-deps/
build/
dist/

# Test and analysis caches.
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tmp_run/

# Generated validation output; only the directory guide is source.
/test-results/*
!/test-results/README.md

# Local tools, sample inputs, references and advisory snapshots.
.tools/
.local/
samples/
advisory-db/
reference-artifacts/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite.manifest.json

# Downloaded executables are never vendored.
osv-scanner
osv-scanner.exe
osv-scanner_windows_*.exe
osv-scanner_linux_*
osv-scanner_darwin_*
osv-scanner_SHA256SUMS

# Local consumer-specific notes are never distributed.
/moraine-integration.md
/docs/integration-moraine.md
